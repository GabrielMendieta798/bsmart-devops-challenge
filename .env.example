# Application environment
APP_ENV=production

# AWS configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Container images
# Replace these illustrative references with validated ECR images.
# Production deployments should preferably use immutable digests.

WEB_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/bsmart-web:git-a1b2c3d
API_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/bsmart-api:git-e4f5a6b
VIDEO_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/bsmart-video:git-c7d8e9f

# Web application
WEB_PORT=8080

# Existing PostgreSQL instance
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=bsmart
DB_USER=bsmart_api

# Persistent video storage
VIDEO_STORAGE_PATH=/mnt/video-data/videos

# Runtime secret files
SECRET_DIR=/run/bsmart-secrets

# Required secret files:
# ${SECRET_DIR}/db_password
# ${SECRET_DIR}/worker_api_token
# ${SECRET_DIR}/external_api_key
#
# Secret files must be provisioned from AWS Secrets Manager
# before starting the containers.
#
# Never store secret values in this file.